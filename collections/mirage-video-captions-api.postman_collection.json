        {
          "id": "2c6682b2-9ae3-4489-81e5-aa2490f85d95",
          "name": "Add Captions to a Video",
          "request": {
            "name": "Add Captions to a Video",
            "description": {
              "content": "Create a captioned video from either an uploaded video file or an existing video ID.\n\nYou must provide exactly one of:\n- `video`: A video file upload (.mp4 or .mov), max 50mb\n- `video_id`: An existing video ID to add captions to\n\nIf providing `video_id`, the source video must have status COMPLETE before it can be captioned.\n\nTo fetch the captioned video, use the `GET videos/{video_id}` endpoint.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "videos",
                "captions"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "disabled": false,
                "description": "(Required) API Key for authentication",
                "key": "x-api-key",
                "value": "<string>"
              },
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "caption_template_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "(Required) Caption style template ID"
                },
                {
                  "key": "video",
                  "value": "<string>",
                  "type": "text",
                  "description": "Video file to caption (MP4, MOV). Must be 9:16 aspect ratio. Max 50mb. Either `video` or `video_id` must be provided."
                },
                {
                  "key": "video_id",
                  "value": "<string>",
                  "type": "text",
                  "description": "Existing video ID to add captions to. Either `video` or `video_id` must be provided."
                }
              ]
            }
